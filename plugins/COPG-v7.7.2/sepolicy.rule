# COPG SELinux policy — Concurrent Mic (mic-share).
# The And64 inline hook makes audioserver's own .text writable+executable to patch
# updateUidStates_l, and allocates an anonymous RWX page for the trampoline. Those need:
allow audioserver audioserver process execmem
allow audioserver system_file file execmod
allow audioserver system_lib_file file execmod
# The payload's reload() polls /data/system/copg_micshare (system_data_file) every 1.5s for the
# live WebUI toggle. Without read access audioserver's fopen fails under Enforcing, so g_enabled
# is stuck at its compile default (true) → enable works but DISABLE never takes without a reboot.
allow audioserver system_data_file file { read open getattr }

allow su su capability net_raw

# Zygisk module (onLoad + preAppSpecialize run in the zygote domain) reads COPG.json, global.json
# and the GPU/SIM/UA manifests from /data/adb/modules/COPG. /data/adb is adb_data_file; Zygisk Next
# <=1.5.2 granted these itself, 1.5.3 dropped them → stat()/open() EACCES → every app "Not in config"
# (ReZygisk still ships the looser rules, so it works there). Blind belt-and-suspenders so a read
# from zygote never fails under ZN regardless of which type a module file carries:
#   • adb_data_file   = /data/adb + /data/adb/modules (dir traversal) and any un-relabeled file.
#   • system_file     = the COPG dir + its files once customize.sh/service.sh chcon them.
# EACCES often comes back with NO avc line (the perm is dontaudit'd), so this is applied blind.
allow zygote adb_data_file dir search
allow zygote adb_data_file file { read open getattr }
allow zygote system_file dir search
allow zygote system_file file { read open getattr }
