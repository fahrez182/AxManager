<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AX MANAGER"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Custom DPI"
            android:textColorHint="#888888"
            style="?attr/textInputLayoutStyle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomDpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Performance Mode"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbSmooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smooth"
                android:textColor="#FFFFFF"
                android:checked="true"
                android:layout_margin="8dp"/>

            <RadioButton
                android:id="@+id/rbHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High"
                android:textColor="#FFFFFF"
                android:layout_margin="8dp"/>

            <RadioButton
                android:id="@+id/rbUltra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultra"
                android:textColor="#FFFFFF"
                android:layout_margin="8dp"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnBoost"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="APPLY BOOST"
            android:backgroundTint="#FFD700"
            android:textColor="#000000"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="RESET TO DEFAULT"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textAlignment="center"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="بخش 120 امن بدون بلید"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvFpsNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="عدد فعلی - باید 120 شود"
            android:textColor="#888888"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnFps120"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="فعال کردن 120 کامل"
            android:backgroundTint="#FFD700"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRestartGame"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ریستارت بازی"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnFloating"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="نمایش پنجره شناور روی لابی"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اول وارد لابی بتل شوید بعد دکمه را بزنید"
            android:textColor="#888888"
            android:textAlignment="center" />

    </LinearLayout>
</ScrollView>
