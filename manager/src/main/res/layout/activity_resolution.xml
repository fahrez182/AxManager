<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    android:padding="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- App Title / Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AXMANAGER // BLADE ENGINE"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Ready for Injection"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Card for Modes and Custom Input -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardModes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Performance Mode"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgModes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbUltra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ultra FPS (DPI 260 - Max Speed)"
                        android:textColor="#FFFFFF"
                        android:checked="true"
                        android:buttonTint="#FFD700" />

                    <RadioButton
                        android:id="@+id/rbHigh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="High Performance (DPI 300)"
                        android:textColor="#FFFFFF"
                        android:buttonTint="#FFD700"
                        android:layout_marginTop="8dp" />

                    <RadioButton
                        android:id="@+id/rbSmooth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Smooth Balanced (DPI 340)"
                        android:textColor="#FFFFFF"
                        android:buttonTint="#FFD700"
                        android:layout_marginTop="8dp" />
                </RadioGroup>

                <!-- Custom DPI Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:boxBackgroundColor="#2D2D2D"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#FFD700"
                    app:hintTextColor="#FFD700">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomDpi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Or Enter Custom DPI (e.g. 280, 320)"
                        android:inputType="number"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnBoost"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:text="APPLY BLADE BOOST"
            android:textColor="#121212"
            android:textStyle="bold"
            android:backgroundTint="#FFD700"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/cardModes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="RESET SYSTEM DEFAULTS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#333333"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnBoost"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
