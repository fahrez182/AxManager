<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OTG activation acts as a USB host; optional so phones without it can still install. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <permission
        android:name="frb.axeron.manager.permission.MANAGER"
        android:protectionLevel="signature" />
    <uses-permission android:name="frb.axeron.manager.permission.MANAGER" />

    <application
        android:name=".AxeronApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:directBootAware="true"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AxManager"
        tools:targetApi="33">

        <!-- singleTask: one AxActivity, in AxManager's own task. Zips from other apps arrive
             through OpenZipActivity below, never directly. -->
        <activity
            android:name=".ui.AxActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible hop for zips opened from other apps: it runs in the sender's task (empty
             affinity, no history, not in recents) and forwards to AxActivity in a new task. -->
        <activity
            android:name=".ui.OpenZipActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Transparent.NoUI">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:mimeType="application/zip" />
                <data android:scheme="content" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RequestPermissionActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:theme="@style/GrantPermissions">
            <intent-filter>
                <action android:name="AxRuntime.REQUEST_PERMISSION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- An app asks for AxManager here, for a result (AxRuntime.REQUEST_ACCESS): the only way
             an app learns it is here before it is allowed. -->
        <activity
            android:name=".ui.RequestAccessActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Transparent.NoUI">
            <intent-filter>
                <action android:name="AxRuntime.REQUEST_ACCESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Opened by component only (WebUIActivity.intentFor, its shortcuts): no filter for
             other apps to find it by. -->
        <activity
            android:name=".ui.webui.WebUIActivity"
            android:autoRemoveFromRecents="true"
            android:documentLaunchMode="intoExisting"
            android:exported="true"
            android:theme="@style/Theme.AxManager.WebUI" />

        <!-- For plugins (`am start` as the server's uid): shell and root hold the permission, an
             app doesn't, so none can show a toast as AxManager. -->
        <activity
            android:name=".Toast"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:taskAffinity=":toast"
            android:theme="@style/Theme.Transparent.NoUI">
            <intent-filter>
                <action android:name="AxManager.TOAST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Save snippet" in the text selection toolbar; not exported, so AxManager only. -->
        <activity
            android:name=".ui.SaveSnippetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/quickshell_bookmark"
            android:noHistory="true"
            android:theme="@style/Theme.Transparent.NoUI">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.CrashActivity"
            android:excludeFromRecents="true"
            android:process=":crash"
            android:theme="@style/Theme.AxManager" />

        <!-- The relay for app_process clients, reached by component
             (AxeronApiConstant.server.RELAY_RECEIVER): no filter for other apps to find it by. -->
        <receiver
            android:name="frb.axeron.manager.receiver.BinderRequestReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver" />

        <provider
            android:name=".AxManagerProvider"
            android:authorities="${applicationId}.server"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".receiver.BootCompleteReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:permission="frb.axeron.manager.permission.MANAGER">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Pinned-shortcut confirmation; only reached through our own PendingIntent. -->
        <receiver
            android:name=".receiver.ShortcutPinnedReceiver"
            android:exported="false" />

        <!-- Started by the boot receiver only: shows the start after a reboot, step by step.
             Direct boot aware, as the receiver is: the locked boot broadcast comes before the
             unlock, when the system won't start a service that isn't. -->
        <service
            android:name=".adb.BootWatchdogService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="shortService"
            tools:ignore="NewApi" />

        <service
            android:name=".features.quicksettings.AxeronTileService"
            android:exported="true"
            android:icon="@drawable/ic_axeron"
            android:label="QuickAccess"
            android:permission="android.permission.BIND_QUICK_SETTINGS">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>